# Docker host port. The container always listens on 8787 internally.
HOST_PORT=8787
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://your-domain.example.com
ADMIN_TOKEN=change-me-long-random-token

# Keep preview while testing. live will actually publish.
PUBLISH_MODE=preview

# Generic job configuration.
JOB_NAME=Binance Square Market Autopost
JOB_DESCRIPTION=基于真实 Binance 行情，生成有交易员视角的短帖。
POST_LANGUAGE=zh-CN
STYLE_GUIDE=短句、克制、有交易感；不要报告腔、模板腔、喊单腔。
CONTENT_SOURCE=binance-market-pack
POST_TARGET=binance-square
DEFAULT_PROMPT_FILE=

# OpenAI-compatible Chat Completions relay.
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.8
OPENAI_MAX_TOKENS=180
OPENAI_TIMEOUT_MS=45000

# Binance Square OpenAPI. Not used until PUBLISH_MODE=live.
BINANCE_SQUARE_OPENAPI_KEY=

# Optional proxy for outbound API calls.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Optional Telegram notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
