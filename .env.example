# Server
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8787
ADMIN_TOKEN=change-me-long-random-token

# OpenAI-compatible Chat Completions.
# You can use the official OpenAI endpoint or any relay that supports /v1/chat/completions.
# These can also be edited in the Web UI; API keys edited in the UI are stored in data/secrets.json.
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.8
OPENAI_MAX_TOKENS=180
OPENAI_TIMEOUT_MS=45000

# Binance Square OpenAPI. Can also be set in the Web UI and stored in data/secrets.json.
BINANCE_SQUARE_OPENAPI_KEY=

# Optional HTTP CONNECT proxy for API requests, e.g. http://127.0.0.1:1082
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Telegram notification, optional. Can also be set in data/secrets.json through API later.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
