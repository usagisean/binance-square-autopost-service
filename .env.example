# Server
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8787
ADMIN_TOKEN=change-me-long-random-token

# preview: only generate content; live: actually publish when requested/scheduled.
PUBLISH_MODE=preview

# Job defaults. These can also be edited in the Web UI.
JOB_NAME=Binance Square Market Autopost
JOB_DESCRIPTION=基于真实 Binance 行情，生成有交易员视角的短帖。
POST_LANGUAGE=zh-CN
STYLE_GUIDE=短句、克制、有交易感；不要报告腔、模板腔、喊单腔。
CONTENT_SOURCE=binance-market-pack
POST_TARGET=binance-square
MAX_DAILY_POSTS=50
# Optional: point to your own prompt template file.
DEFAULT_PROMPT_FILE=

# OpenAI-compatible Chat Completions.
# Recommended flow: keep secrets out of Git and configure channels/models in the Web UI.
# Web UI stores multi-channel model config in data/llm_config.json.
# Legacy env values below are used as the initial/default channel and fallback.
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.8
OPENAI_MAX_TOKENS=8192
OPENAI_TIMEOUT_MS=45000

# Binance Square OpenAPI. Can also be set in the Web UI and stored in data/secrets.json.
BINANCE_SQUARE_OPENAPI_KEY=

# Optional HTTP CONNECT proxy for API requests, e.g. http://127.0.0.1:1082
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Telegram notification, optional. Can also be set in data/secrets.json through API later.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional image post support. Default off; image paths are relative to /app/data in Docker.
ENABLE_IMAGE_POSTS=false
AUTO_GENERATE_IMAGE=false
AUTO_IMAGE_MAX_DAILY=20
IMAGE_POST_MODE=static
IMAGE_PATH_COUNT=1
IMAGE_PATHS=
